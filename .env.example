# PostgreSQL
POSTGRES_DB=eventomax_report
DB_URL=jdbc:postgresql://localhost:5434/eventomax_report
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Host Ports (Report avoids collision with Notify 8083)
REPORT_PORT=8085

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=report-group
KAFKA_LISTENER_AUTO_STARTUP=true
KAFKA_TOPIC_PRODUCTION_EVENTS=productions.events
KAFKA_TOPIC_REPORT_DLT=productions.events.report.DLT
KAFKA_RETRY_MAX_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_MS=1000

